{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "rewriteRelativeImportExtensions": true,
    "types": []
  },
  "include": [
    "src"
  ],
  "exclude": [
    "tests",
    "scripts",
    "demo"
  ]
}
